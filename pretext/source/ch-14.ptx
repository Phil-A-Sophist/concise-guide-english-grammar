        <row bottom="minor"><cell>Phrase</cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell></row>
        <row bottom="minor"><cell>Word</cell><cell><foreign>What</foreign></cell><cell><foreign>she</foreign></cell><cell><foreign>said</foreign></cell><cell><foreign>surprised</foreign></cell><cell><foreign>everyone</foreign></cell></row>
        <row bottom="minor"><cell>POS</cell><cell></cell><cell></cell><cell></cell><cell></cell><cell></cell></row>
      </tabular>
      <ul><li><p>Bracket notation: _____</p></li><li><p>Diagram:</p></li></ul>

      <p><em>Exercise 19.</em> <foreign>He enjoys swimming in the lake.</foreign></p>
      <tabular top="minor" left="minor">
        <col halign="left" right="minor"/>
        <col halign="center" right="minor"/>
        <col halign="center" right="minor"/>
        <col halign="center" right="minor"/>
